    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@swc/core": "^1.15.41",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.3",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "vite": "^7.3.5",
    "vitest": "^4.1.8",
    "wait-on": "^9.0.10"
